<div class="page-template">
<div class="container">
{% if cart.item_count > 0 %}
<div class="cart-layout" data-animate="fade-up">
<div class="cart-layout__main">
<div class="cart-layout__heading">
<h1 class="cart-layout__title">Shopping Bag</h1>
<span class="cart-layout__count">{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</span>
</div>
<div class="cart-items">
{% for item in cart.items %}
<div class="cart-item" data-line="{{ forloop.index }}" data-key="{{ item.key }}">
<div class="cart-item__img">
{% if item.image != blank %}
<img src="{{ item.image | image_url: width: 300 }}" alt="{{ item.title | escape }}" loading="lazy" width="300" height="375">
{% endif %}
</div>
<div class="cart-item__details">
<div class="cart-item__top">
<div class="cart-item__info">
<a href="{{ item.url }}" class="cart-item__title">{{ item.product.title }}</a>
{% if item.variant.title != 'Default Title' %}
<span class="cart-item__variant">{{ item.variant.title }}</span>
{% endif %}
</div>
<a href="{{ item.url_to_remove }}" class="cart-item__remove-btn" aria-label="Remove {{ item.product.title | escape }}">
<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
</a>
</div>
<div class="cart-item__bottom">
<div class="quantity-selector">
<button type="button" data-qty-minus aria-label="Decrease quantity">&#8722;</button>
<input type="number" value="{{ item.quantity }}" min="0" aria-label="Quantity">
<button type="button" data-qty-plus aria-label="Increase quantity">+</button>
</div>
<div class="cart-item__total">{{ item.final_line_price | money }}</div>
</div>
</div>
</div>
{% endfor %}
</div>
</div>
<div class="cart-layout__sidebar">
<div class="cart-summary">
<h2 class="cart-summary__title">Order Summary</h2>
<div class="cart-summary__row">
<span>Subtotal ({{ cart.item_count }} items)</span>
<span>{{ cart.total_price | money }}</span>
</div>
<div class="cart-summary__row cart-summary__row--muted">
<span>Shipping</span>
<span>Calculated at checkout</span>
</div>
<div class="cart-summary__divider"></div>
<div class="cart-summary__row cart-summary__row--total">
<span>Total</span>
<span>{{ cart.total_price | money }}</span>
</div>
<form action="{{ routes.cart_url }}" method="post">
<button type="submit" name="checkout" class="btn btn--primary btn--large btn--full cart-summary__checkout">Proceed to Checkout</button>
</form>
<div class="cart-summary__secure">
<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
<span>Secure checkout &middot; Coupon codes can be applied at checkout</span>
</div>
<div class="payment-icons">
<div class="payment-icons__list">
{% for type in shop.enabled_payment_types %}
{{ type | payment_type_svg_tag }}
{% endfor %}
</div>
</div>
</div>
</div>
</div>
{% else %}
<div class="page-404" data-animate="fade-up">
<div>
<svg width="60" height="60" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" aria-hidden="true"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
<h2>Your cart is empty</h2>
<p class="page-404__text">Looks like you haven't added anything to your cart yet.</p>
<a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Continue Shopping</a>
</div>
</div>
{% endif %}
</div>
</div>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": []
}
{% endschema %}
