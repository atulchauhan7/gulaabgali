<div class="product-page">
<div class="container">

<nav class="product-breadcrumbs" aria-label="Breadcrumb">
<a href="{{ routes.root_url }}">Home</a>
<span aria-hidden="true">/</span>
{% if product.collections.size > 0 %}
<a href="{{ product.collections.first.url }}">{{ product.collections.first.title }}</a>
<span aria-hidden="true">/</span>
{% endif %}
<span class="product-breadcrumbs__current" aria-current="page">{{ product.title | truncate: 40 }}</span>
</nav>

{% assign has_discount = false %}
{% if product.compare_at_price > product.price %}
  {% assign has_discount = true %}
{% endif %}

<div class="product-page__grid">

<!-- === GALLERY === -->
<div class="product-gallery product-gallery--slider">
<div class="product-gallery__viewport">
{% if has_discount %}<span class="product-gallery__badge product-gallery__badge--sale">SALE</span>{% elsif product.tags contains 'new' or product.tags contains 'New' or product.tags contains 'NEW' %}<span class="product-gallery__badge">NEW IN</span>{% endif %}
<div class="product-gallery__track">
{% for image in product.images %}
<div class="product-gallery__slide">
<img
src="{{ image | image_url: width: 800 }}"
srcset="{{ image | image_url: width: 400 }} 400w, {{ image | image_url: width: 600 }} 600w, {{ image | image_url: width: 800 }} 800w, {{ image | image_url: width: 1200 }} 1200w"
sizes="(max-width: 768px) 100vw, 55vw"
alt="{{ image.alt | default: product.title | escape }}"
width="1200"
height="{{ 1200 | divided_by: image.aspect_ratio | default: 0.75 | round }}"
loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
{% if forloop.first %}fetchpriority="high"{% endif %}
decoding="async">
</div>
{% else %}
<div class="product-gallery__slide">{{ 'product-1' | placeholder_svg_tag }}</div>
{% endfor %}
</div>
{% if product.images.size > 1 %}
<div class="product-gallery__counter"><span data-gallery-current>1</span> / {{ product.images.size }}</div>
<button class="product-gallery__arrow product-gallery__arrow--prev" type="button" aria-label="Previous image">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="15 18 9 12 15 6"/></svg>
</button>
<button class="product-gallery__arrow product-gallery__arrow--next" type="button" aria-label="Next image">
<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="9 6 15 12 9 18"/></svg>
</button>
{% endif %}
</div>
{% if product.images.size > 1 %}
<div class="product-gallery__dots">
{% for image in product.images %}
<button class="product-gallery__dot{% if forloop.first %} active{% endif %}" data-slide="{{ forloop.index0 }}" aria-label="Go to image {{ forloop.index }}"></button>
{% endfor %}
</div>
{% endif %}
</div>

<!-- === PRODUCT INFO === -->
<div class="product-info">

  {% if product.vendor != blank %}
  <div class="product-info__vendor-row">
    <div class="product-info__vendor">{{ product.vendor }}<svg class="product-info__vendor-badge" width="14" height="14" viewBox="0 0 24 24" fill="var(--color-accent)" stroke="#fff" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg></div>
    <button class="pdp-wishlist-icon" type="button" aria-label="Add to wishlist"
      data-wishlist-toggle
      data-product-handle="{{ product.handle }}"
      data-product-title="{{ product.title | escape }}"
      data-product-url="{{ product.url }}"
      data-product-price="{{ product.price | money }}"
      data-product-image="{% if product.featured_image != blank %}{{ product.featured_image | image_url: width: 200 }}{% endif %}">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
  </div>
  {% endif %}

  <h1 class="product-info__title">{{ product.title }}</h1>

  {% if settings.product_show_rating %}
  {% assign review_count = product.metafields.reviews.rating_count.value %}
  {% assign review_rating = product.metafields.reviews.rating.value %}
  {% if review_count > 0 and review_rating != blank %}
  {% assign rx10 = review_rating | times: 10 | round %}
  {% assign star_whole = rx10 | divided_by: 10 %}
  {% assign star_frac = rx10 | modulo: 10 %}
  {% assign star_frac_pct = star_frac | times: 10 %}
  {% assign star_next = star_whole | plus: 1 %}
  <div class="product-info__rating">
    <div class="product-info__stars" aria-label="Rated {{ star_whole }}.{{ star_frac }} out of 5">
      {% for i in (1..5) %}
      {% if i <= star_whole %}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="var(--color-accent)" stroke="none" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {% elsif i == star_next and star_frac > 0 %}
      <svg width="14" height="14" viewBox="0 0 24 24" stroke="none" aria-hidden="true"><defs><linearGradient id="pstar-{{ product.id }}"><stop offset="{{ star_frac_pct }}%" stop-color="var(--color-accent)"/><stop offset="{{ star_frac_pct }}%" stop-color="#e0e0e0"/></linearGradient></defs><path fill="url(#pstar-{{ product.id }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {% else %}
      <svg width="14" height="14" viewBox="0 0 24 24" fill="#e0e0e0" stroke="none" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
      {% endif %}
      {% endfor %}
    </div>
    <a href="#pdp-reviews" class="product-info__review-count">{{ review_rating | round: 1 }} ({{ review_count }} {{ review_count | pluralize: 'review', 'reviews' }})</a>
  </div>
  {% endif %}
  {% endif %}

  <div class="product-info__price-wrap">
    {% if has_discount %}
    {% assign savings_amount = product.compare_at_price | minus: product.price %}
    {% assign pct_off = savings_amount | times: 100 | divided_by: product.compare_at_price %}
    <div class="product-info__price-row">
      <span class="product-info__price product-info__price--on-sale">{{ product.price | money }}</span>
      <span class="product-info__compare-price"><s>{{ product.compare_at_price | money }}</s></span>
      <span class="product-info__save-badge">{{ pct_off }}% OFF</span>
    </div>
    <p class="product-info__savings">You save {{ savings_amount | money }} on this product</p>
    {% else %}
    <span class="product-info__price">{{ product.price | money }}</span>
    {% endif %}
    {% if settings.product_tax_note != blank %}
    <span class="product-info__tax-note">{{ settings.product_tax_note }}</span>
    {% endif %}
  </div>

  {% form 'product', product, data-add-to-cart: true, data-product-form: true %}
  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">

  {% unless product.has_only_default_variant %}
  <script type="application/json" data-product-variants>{{ product.variants | json }}</script>
  <div class="product-info__options">
    {% for option in product.options_with_values %}
    {% assign option_name_down = option.name | downcase %}
    {% assign is_size = false %}
    {% if option_name_down == 'size' or option_name_down == 'sizes' %}{% assign is_size = true %}{% endif %}
    <div class="product-option" data-option-index="{{ forloop.index0 }}" data-option-name="{{ option.name | escape }}">
      <label class="product-option__label">
        {{ option.name }}
        {% if is_size %}{% if product.metafields.custom.size_chart != blank %}
        <button type="button" class="size-chart-trigger" data-size-chart-open aria-label="View size chart">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 3H3v18h18V3z"/><path d="M3 9h3M3 15h5M3 12h4"/></svg>
          Size Guide
        </button>
        {% endif %}{% endif %}
      </label>
      <div class="product-option__values" role="group" aria-label="{{ option.name | escape }}">
        {% for value in option.values %}
        {% assign option_id = 'option-' | append: section.id | append: '-' | append: forloop.parentloop.index0 | append: '-' | append: forloop.index0 %}
        <input
          type="radio"
          class="product-option__radio visually-hidden"
          id="{{ option_id }}"
          name="options[{{ option.name | escape }}]"
          value="{{ value | escape }}"
          data-option-index="{{ forloop.parentloop.index0 }}"
          {% if option.selected_value == value %}checked{% endif %}>
        <label class="product-option__value{% if option.selected_value == value %} selected{% endif %}" for="{{ option_id }}" data-option-value>{{ value }}</label>
        {% endfor %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endunless %}

  {% assign promo_text = product.metafields.custom.promo_text | default: nil %}
  {% assign promo_code = product.metafields.custom.promo_code | default: nil %}
  {% if promo_text == blank %}{% assign promo_text = settings.product_promo_text %}{% endif %}
  {% if promo_code == blank %}{% assign promo_code = settings.product_promo_code %}{% endif %}

  {% if settings.product_promo_enabled and promo_code != blank %}
  <div class="pdp-ticket">
    <div class="pdp-ticket__left">
      <svg class="pdp-ticket__icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="9" r="2"/><circle cx="15" cy="15" r="2"/><line x1="7.5" y1="16.5" x2="16.5" y2="7.5"/><path d="M21.41 11.58l-9-9a2 2 0 00-2.82 0L2 10.17V22h11.83l7.58-7.58a2 2 0 000-2.84z"/></svg>
      <div class="pdp-ticket__info">
        <span class="pdp-ticket__heading">{{ promo_text | escape }}</span>
        <span class="pdp-ticket__sub">Tap the code to copy &amp; apply at checkout</span>
      </div>
    </div>
    <div class="pdp-ticket__divider"></div>
    <div class="pdp-ticket__right">
      <span class="pdp-ticket__label">YOUR CODE</span>
      <button type="button" class="pdp-ticket__code" data-copy-code="{{ promo_code | escape }}">{{ promo_code | escape }}<svg class="pdp-ticket__copy-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg></button>
    </div>
  </div>
  {% endif %}

  <div class="product-info__quantity">
    <label class="product-option__label" for="product-quantity">Quantity</label>
    <div class="quantity-selector">
      <button type="button" data-qty-minus aria-label="Decrease quantity">&#8722;</button>
      <input type="number" id="product-quantity" name="quantity" value="1" min="1" aria-label="Quantity">
      <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
    </div>
  </div>

  <div class="product-info__cta-desktop">
    <button type="submit" class="btn btn--primary btn--full btn--large" {% unless product.available %}disabled{% endunless %}>
      {% if product.available %}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg> Add to Cart{% else %}Sold Out{% endif %}
    </button>
    {% if product.available %}
    <button type="button" class="btn btn--buy-now btn--full btn--large" data-buy-now>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Buy Now
    </button>
    {% endif %}
  </div>

  <div class="product-info__cta-group">
    <div class="product-info__add-to-cart">
      <button type="submit" class="btn btn--primary btn--full btn--large" {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
      </button>
    </div>
    {% if product.available %}
    <button type="button" class="btn btn--buy-now btn--full btn--large" data-buy-now>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg> Buy Now
    </button>
    {% endif %}
  </div>
  {% endform %}

  {% assign delivery_min_sec = settings.product_delivery_min_days | default: 3 | times: 86400 %}
  {% assign delivery_max_sec = settings.product_delivery_max_days | default: 7 | times: 86400 %}
  <div class="product-delivery">
    <div class="product-delivery__icon">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
    </div>
    <div class="product-delivery__text">
      <strong>Estimated Delivery</strong>
      <span>{{ 'now' | date: '%s' | plus: delivery_min_sec | date: '%b %d' }} — {{ 'now' | date: '%s' | plus: delivery_max_sec | date: '%b %d, %Y' }}</span>
    </div>
  </div>

  {% if settings.product_trust_1 != blank or settings.product_trust_2 != blank or settings.product_trust_3 != blank or settings.product_trust_4 != blank %}
  <div class="product-trust">
    {% if settings.product_trust_1 != blank %}<div class="product-trust__item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg><span>{{ settings.product_trust_1 }}</span></div>{% endif %}
    {% if settings.product_trust_2 != blank %}<div class="product-trust__item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg><span>{{ settings.product_trust_2 }}</span></div>{% endif %}
    {% if settings.product_trust_3 != blank %}<div class="product-trust__item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>{{ settings.product_trust_3 }}</span></div>{% endif %}
    {% if settings.product_trust_4 != blank %}<div class="product-trust__item"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg><span>{{ settings.product_trust_4 }}</span></div>{% endif %}
  </div>
  {% endif %}

  {% if settings.product_show_share %}
  {% assign share_url = shop.url | append: product.url %}
  <div class="product-share">
    <span class="product-share__label">Share</span>
    <div class="product-share__buttons">
      <a class="product-share__btn product-share__btn--facebook" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg></a>
      <a class="product-share__btn product-share__btn--twitter" href="https://twitter.com/intent/tweet?text={{ product.title | url_encode }}&url={{ share_url | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on X (Twitter)"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.747l7.73-8.835L1.254 2.25H8.08l4.253 5.622zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
      <a class="product-share__btn product-share__btn--pinterest" href="https://pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&media={{ product.featured_image | image_url: width: 1200 | url_encode }}&description={{ product.title | url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share on Pinterest"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.373 0 0 5.373 0 12c0 5.084 3.163 9.426 7.627 11.174-.105-.949-.2-2.405.042-3.441.218-.937 1.407-5.965 1.407-5.965s-.359-.719-.359-1.782c0-1.668.967-2.914 2.171-2.914 1.023 0 1.518.769 1.518 1.69 0 1.029-.655 2.568-.994 3.995-.283 1.194.599 2.169 1.777 2.169 2.133 0 3.772-2.249 3.772-5.495 0-2.873-2.064-4.882-5.012-4.882-3.414 0-5.418 2.561-5.418 5.207 0 1.031.397 2.138.893 2.738a.36.36 0 01.083.345l-.333 1.36c-.053.22-.174.267-.402.161-1.499-.698-2.436-2.889-2.436-4.649 0-3.785 2.75-7.262 7.929-7.262 4.163 0 7.398 2.967 7.398 6.931 0 4.136-2.607 7.464-6.227 7.464-1.216 0-2.359-.632-2.75-1.378l-.748 2.853c-.271 1.043-1.002 2.35-1.492 3.146C9.57 23.812 10.763 24 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0z"/></svg></a>
      <button class="product-share__btn product-share__btn--copy" type="button" data-share-copy aria-label="Copy product link"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg><span class="product-share__copy-tip">Copied!</span></button>
    </div>
  </div>
  {% endif %}

  <div class="product-accordion">
    {% if product.description != blank %}
    <div class="accordion-item open">
      <button class="accordion-trigger" type="button" aria-expanded="true">Description<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
      <div class="accordion-content" style="max-height:500px"><div class="accordion-content__inner">{{ product.description }}</div></div>
    </div>
    {% endif %}
    {% if settings.product_shipping_text != blank %}
    <div class="accordion-item">
      <button class="accordion-trigger" type="button" aria-expanded="false">Shipping &amp; Returns<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
      <div class="accordion-content"><div class="accordion-content__inner">{{ settings.product_shipping_text }}</div></div>
    </div>
    {% endif %}
    {% if settings.product_care_text != blank %}
    <div class="accordion-item">
      <button class="accordion-trigger" type="button" aria-expanded="false">Care Instructions<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></button>
      <div class="accordion-content"><div class="accordion-content__inner">{{ settings.product_care_text }}</div></div>
    </div>
    {% endif %}
  </div>

  <div class="product-info__meta">
    {% if product.vendor != blank %}<div class="product-info__meta-item"><strong>Brand:</strong> {{ product.vendor }}</div>{% endif %}
    <div class="product-info__meta-item"><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | default: 'N/A' }}</div>
    <div class="product-info__meta-item"><strong>Type:</strong> {{ product.type | default: 'N/A' }}</div>
  </div>

</div>
</div>
</div>
</div>

{% if settings.product_show_rating %}
{% assign review_count = product.metafields.reviews.rating_count.value %}
{% assign review_rating = product.metafields.reviews.rating.value %}
{% if review_count > 0 and review_rating != blank %}
{% assign rx10 = review_rating | times: 10 | round %}
{% assign star_whole = rx10 | divided_by: 10 %}
{% assign star_frac = rx10 | modulo: 10 %}
{% assign star_frac_pct = star_frac | times: 10 %}
{% assign star_next = star_whole | plus: 1 %}
<div class="pdp-reviews" id="pdp-reviews">
<div class="container">
  <div class="pdp-reviews__header">
    <div class="pdp-reviews__header-left">
      <h2 class="pdp-reviews__title">Customer Reviews</h2>
      <div class="pdp-reviews__summary">
        <div class="pdp-reviews__avg">
          <span class="pdp-reviews__avg-number">{{ review_rating | round: 1 }}</span>
          <div class="pdp-reviews__avg-stars" aria-label="Rated {{ review_rating | round: 1 }} out of 5">
            {% for i in (1..5) %}{% if i <= star_whole %}<svg width="16" height="16" viewBox="0 0 24 24" fill="var(--color-accent)" stroke="none" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% elsif i == star_next and star_frac > 0 %}<svg width="16" height="16" viewBox="0 0 24 24" stroke="none" aria-hidden="true"><defs><linearGradient id="rstar-{{ product.id }}"><stop offset="{{ star_frac_pct }}%" stop-color="var(--color-accent)"/><stop offset="{{ star_frac_pct }}%" stop-color="#e0e0e0"/></linearGradient></defs><path fill="url(#rstar-{{ product.id }})" d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% else %}<svg width="16" height="16" viewBox="0 0 24 24" fill="#e0e0e0" stroke="none" aria-hidden="true"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>{% endif %}{% endfor %}
          </div>
        </div>
        <span class="pdp-reviews__count">Based on {{ review_count }} {{ review_count | pluralize: 'review', 'reviews' }}</span>
      </div>
    </div>
  </div>
  <div class="pdp-reviews__app-placeholder">
    <p>Reviews are powered by a third-party app.</p>
  </div>
</div>
</div>
{% endif %}
{% endif %}

{% if product.collections.size > 0 %}
{% assign rec_collection = product.collections.first %}
{% assign rec_count = 0 %}
{% for p in rec_collection.products limit: 9 %}{% if p.id != product.id %}{% assign rec_count = rec_count | plus: 1 %}{% endif %}{% endfor %}
{% if rec_count > 0 %}
<div class="pdp-recommendations">
<div class="container">
  <div class="section-header--with-nav">
    <div><div class="section-header__subtitle">Curated for you</div><h2 class="section-header__title">You Might Also Like</h2></div>
  </div>
  <div class="carousel pdp-reco-carousel" data-carousel data-carousel-per-view="4" data-carousel-gap="24" data-carousel-loop="true">
    <div class="carousel__viewport"><div class="carousel__track" data-carousel-track>
      {% for p in rec_collection.products limit: 9 %}{% if p.id != product.id %}<div class="carousel__slide" data-carousel-slide>{% render 'product-card', product: p %}</div>{% endif %}{% endfor %}
    </div></div>
    <div class="carousel__dots" data-carousel-dots></div>
  </div>
</div>
</div>
{% endif %}
{% endif %}

{% unless product.has_only_default_variant %}
<div class="size-sheet-overlay" id="size-sheet-overlay"></div>
<div class="size-sheet" id="size-sheet" aria-hidden="true">
<div class="size-sheet__header">
<span class="size-sheet__title">Select Size</span>
<button class="size-sheet__close" aria-label="Close" type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
</div>
<div class="size-sheet__sizes" id="size-sheet-sizes"></div>
<button class="btn btn--primary btn--full size-sheet__add" id="size-sheet-add" type="button" disabled>Select a size</button>
</div>
{% endunless %}

{% assign sc = product.metafields.custom.size_chart.value %}
{% if sc != blank %}
<div class="size-chart-overlay" id="size-chart-modal" aria-hidden="true">
<div class="size-chart-modal">
  <div class="size-chart-modal__header">
    <span class="size-chart-modal__title">Size Guide</span>
    <button class="size-chart-modal__close" type="button" aria-label="Close size chart" data-size-chart-close><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg></button>
  </div>
  <div class="size-chart-modal__tabs">
    <button class="size-chart-tab active" data-sc-tab="chart" type="button">Size Chart</button>
    <button class="size-chart-tab" data-sc-tab="measure" type="button">How to Measure</button>
  </div>
  <div class="size-chart-modal__body">
    <div class="size-chart-panel active" data-sc-panel="chart">
      <p class="size-chart-modal__note">All measurements in <strong>{{ sc.unit | default: 'inches' }}</strong>.</p>
      <div class="size-chart-modal__table-wrap">
        <table class="size-chart-table" data-size-chart>
          <thead><tr>{% for col in sc.headers %}<th scope="col">{{ col }}</th>{% endfor %}</tr></thead>
          <tbody>{% for row in sc.rows %}<tr data-size="{{ row[0] }}">{% for cell in row %}<td>{{ cell }}</td>{% endfor %}</tr>{% endfor %}</tbody>
        </table>
      </div>
    </div>
    <div class="size-chart-panel" data-sc-panel="measure">
      <div class="measure-guide">
        <div class="measure-guide__item"><div class="measure-guide__text"><strong>Bust</strong><p>Measure around the fullest part of your chest, keeping the tape level across the back.</p></div></div>
        <div class="measure-guide__item"><div class="measure-guide__text"><strong>Waist</strong><p>Measure around the narrowest part of your natural waistline, usually just above the navel.</p></div></div>
        <div class="measure-guide__item"><div class="measure-guide__text"><strong>Hip</strong><p>Measure around the widest part of your hips, approximately 8 inches below your waist.</p></div></div>
      </div>
    </div>
  </div>
</div>
</div>
{% endif %}

<script type="application/ld+json">
{
"@context": "https://schema.org/",
"@type": "Product",
"name": {{ product.title | json }},
{% if product.featured_image != blank %}"image": {{ product.featured_image | image_url: width: 1200 | json }},{% endif %}
"description": {{ product.description | strip_html | truncate: 250 | json }},
{% if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
{% if product.selected_or_first_available_variant.barcode != blank %}"gtin": {{ product.selected_or_first_available_variant.barcode | json }},{% endif %}
"brand": {"@type": "Brand","name": {{ product.vendor | json }}},
{% assign rc = product.metafields.reviews.rating_count %}{% assign rv = product.metafields.reviews.rating %}{% if rc != blank and rc > 0 %}
"aggregateRating": {"@type": "AggregateRating","ratingValue": {{ rv | default: 5 }},"reviewCount": {{ rc }}},
{% endif %}
"offers": {
"@type": "Offer",
"url": {{ request.origin | append: product.url | json }},
"priceCurrency": {{ cart.currency.iso_code | json }},
"price": {{ product.price | divided_by: 100.0 }},
"priceValidUntil": "{{ 'now' | date: '%Y' | plus: 1 }}-12-31",
"itemCondition": "https://schema.org/NewCondition",
"availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/OutOfStock{% endif %}"
}
}
</script>

{% schema %}
{
  "name": "Product",
  "tag": "section",
  "settings": []
}
{% endschema %}
